---
import { u } from '../lib/url';
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title, description = 'Telluride Tech provides local IT support in Telluride, Colorado. Not taking on new clients at this time. Software and app development is handled by Mount M Technologies.' } = Astro.props;
const fullTitle = title ? `${title} · Telluride Tech` : 'Telluride Tech · Local IT support in Telluride';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="notice"><div class="wrap">Telluride Tech is not taking on new work at this time. Looking for software or a website? <a href="https://mountm.tech">Visit Mount M Technologies</a>.</div></div>
  <header class="site-header">
    <div class="wrap">
      <a class="logo" href={u("/")}><img src={u("/favicon.svg")} alt="" width="34" height="34" />Telluride Tech</a>
      <a class="btn btn-mm" href="https://mountm.tech"><span class="hide-sm">Software? </span>Mount M →</a>
    </div>
  </header>
  <main><slot /></main>
  <footer class="site-footer">
    <div class="wrap">
      <div>Telluride Tech · Telluride, Colorado · <a href="mailto:michael@telluridetech.com">michael@telluridetech.com</a></div>
      <div>Software development by <a href="https://mountm.tech">Mount M Technologies, LLC</a> · © {new Date().getFullYear()}</div>
    </div>
  </footer>
</body>
</html>
